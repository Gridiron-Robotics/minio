# ── shared MinIO object store ────────────────────────────────────────────────
# Root credentials (console + admin). Change these; never commit real values.
MINIO_ROOT_USER=gridiron_admin
MINIO_ROOT_PASSWORD=change_me_min_8_chars

# MCP sidecar service-account keys (scoped to t-* buckets by bootstrap.sh).
MCP_MINIO_ACCESS_KEY=gridiron-mcp
MCP_MINIO_SECRET_KEY=change_me_min_8_chars

# Caller gate for the MCP sidecar — the brain/gateways present this bearer.
# REQUIRED: `docker compose` refuses to start without it, and the sidecar itself
# exits 78 (EX_CONFIG) if MCP_AUTH_TOKEN is unset. Must match the brain's
# GATEWAY_TOKENS[minio-mcp], or the sidecar boots fine and every brain call 401s.
# Local-dev-only escape hatch: MINIO_MCP_ALLOW_INSECURE=1 lets the sidecar boot
# tokenless, but it then authenticates NO ONE — /tools and /invoke answer 401.
MINIO_MCP_TOKEN=

# Pre-provision buckets for these (space-separated) tenants x modules.
BOOTSTRAP_TENANTS=default
BOOTSTRAP_MODULES=safedocs nocobase gdc floorplans bigcapital lago inventree horilla openproject marketing orders inventory

# ── per-module S3 service accounts (how a module talks S3 DIRECTLY to the store) ─
# For each module above, set a key/secret pair to have bootstrap.sh mint a
# service account scoped to ONLY that module's buckets across every tenant
# (t-*-<module>). The consumer sets these same values as its S3 credentials
# (endpoint http://minio:9000, path-style, region us-east-1). Env var names are
# the module upper-cased with '-'→'_'. A module left unset here falls back to the
# broad gridiron-storage account. Change every secret; keep them in Infisical.
S3_KEY_SAFEDOCS=svc-safedocs
S3_SECRET_SAFEDOCS=change_me_min_8_chars
S3_KEY_NOCOBASE=svc-nocobase
S3_SECRET_NOCOBASE=change_me_min_8_chars
S3_KEY_GDC=svc-gdc
S3_SECRET_GDC=change_me_min_8_chars
S3_KEY_FLOORPLANS=svc-floorplans
S3_SECRET_FLOORPLANS=change_me_min_8_chars
S3_KEY_BIGCAPITAL=svc-bigcapital
S3_SECRET_BIGCAPITAL=change_me_min_8_chars
S3_KEY_LAGO=svc-lago
S3_SECRET_LAGO=change_me_min_8_chars
S3_KEY_INVENTREE=svc-inventree
S3_SECRET_INVENTREE=change_me_min_8_chars
S3_KEY_HORILLA=svc-horilla
S3_SECRET_HORILLA=change_me_min_8_chars
S3_KEY_OPENPROJECT=svc-openproject
S3_SECRET_OPENPROJECT=change_me_min_8_chars
S3_KEY_MARKETING=svc-marketing
S3_SECRET_MARKETING=change_me_min_8_chars
S3_KEY_ORDERS=svc-orders
S3_SECRET_ORDERS=change_me_min_8_chars
S3_KEY_INVENTORY=svc-inventory
S3_SECRET_INVENTORY=change_me_min_8_chars

# ── single login: Keycloak OIDC federation (optional; unset = local root only) ─
# Register a 'minio' client in the erp realm, then:
MINIO_OIDC_CONFIG_URL=https://keycloak.gridironrobotics.com/realms/erp/.well-known/openid-configuration
MINIO_OIDC_CLIENT_ID=minio
MINIO_OIDC_CLIENT_SECRET=
MINIO_OIDC_CLAIM_NAME=policy

# ── encryption at rest (SSE-KMS via KES; optional) ───────────────────────────
MINIO_KMS_KES_ENDPOINT=
MINIO_KMS_KES_KEY_NAME=

# ── ports (host-published; on the shared network modules use container names) ─
MINIO_S3_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_MCP_PORT=8090
MINIO_PRESIGN_EXPIRY=15m
